{
  "cleanUrls": true,
  "buildCommand": "node scripts/build-case-studies.mjs && node scripts/build-blog.mjs && node scripts/build-es.mjs",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/about-me", "destination": "/#about", "permanent": true },
    { "source": "/education", "destination": "/#about", "permanent": true },
    { "source": "/es/about-me", "destination": "/es/#about", "permanent": true },
    { "source": "/es/education", "destination": "/es/#about", "permanent": true }
  ],
  "rewrites": [
    { "source": "/iptv-:uuid([a-f0-9-]+)/:path*", "destination": "https://jaimem-iptv.vercel.app/iptv-:uuid/:path*" }
  ],
  "crons": [
    { "path": "/api/airbnb-sync", "schedule": "0 13 * * *" }
  ],
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/samples/commission-calculator.pdf",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, noarchive" }
      ]
    },
    {
      "source": "/(.*\\.(?:webp|jpg|jpeg|png|svg|ico))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/styles/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, stale-while-revalidate=86400" }
      ]
    }
  ]
}
